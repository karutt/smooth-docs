{
  "name": "smooth-docs-kit",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "smdocs": "bin/smooth-docs.mjs",
    "smooth-docs": "bin/smooth-docs.mjs"
  },
  "scripts": {
    "smdocs": "node bin/smooth-docs.mjs",
    "smooth-docs": "node bin/smooth-docs.mjs",
    "dev": "node bin/smooth-docs.mjs run examples/basic",
    "build": "node bin/smooth-docs.mjs build examples/basic",
    "generate": "SMOOTH_DOCS_PROJECT_DIR=examples/basic node scripts/generate-all-content.mjs",
    "test:chat": "vitest run --config vitest.codex-chat.config.ts",
    "test:flow": "node --test tests/docs-flow/*.test.mjs",
    "test:flow-ui": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@xyflow/react": "^12.11.5",
    "ajv": "^8.20.0",
    "beautiful-mermaid": "1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "0.11.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "html-to-image": "1.11.11",
    "katex": "^0.17.0",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "chokidar": "^4.0.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "patchedDependencies": {
      "beautiful-mermaid": "patches/beautiful-mermaid.patch"
    }
  }
}
