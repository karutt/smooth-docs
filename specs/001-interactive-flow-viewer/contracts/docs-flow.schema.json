{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smooth-docs.local/schemas/docs-flow-v1.schema.json",
  "title": "Smooth Docs Flow Document v1",
  "description": "Canonical authored contract for one editable Smooth Docs workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "kind",
    "title",
    "direction",
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "kind": {
      "const": "workflow"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "direction": {
      "enum": [
        "right",
        "down"
      ]
    },
    "lanes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/lane"
      },
      "default": []
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 150,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "stories": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/story"
      },
      "default": []
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "href"
      ],
      "properties": {
        "kind": {
          "enum": [
            "docs",
            "source",
            "external"
          ]
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "label": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "action",
            "decision",
            "service",
            "external",
            "note"
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "lane": {
          "$ref": "#/$defs/id"
        },
        "owner": {
          "type": "string",
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "maxLength": 64
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "links": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/link"
          },
          "default": []
        },
        "position": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "style": {
          "enum": [
            "normal",
            "error",
            "async"
          ],
          "default": "normal"
        }
      }
    },
    "storyStep": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node"
          ],
          "properties": {
            "node": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "edge"
          ],
          "properties": {
            "edge": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 300,
          "items": {
            "$ref": "#/$defs/storyStep"
          }
        }
      }
    }
  }
}
